# The only required setting is an LLM. Everything else is optional.

# LLM: github (GitHub Models, default) | openai | azure (uses AZURE_OPENAI_* below) | fake (offline, scripted)
LLM_PROVIDER=github
# A GitHub token with the models:read scope for github, an OpenAI key for openai
LLM_API_KEY=
# Optional: defaults to openai/gpt-4o on GitHub Models, gpt-4o on OpenAI
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# Azure OpenAI (only with LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Azure AI Content Safety (optional; without it content checks are off, PII redaction still runs)
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=

# Azure Immersive Reader (optional; the frontend falls back to its built-in reader)
IMMERSIVE_READER_TENANT_ID=
IMMERSIVE_READER_CLIENT_ID=
IMMERSIVE_READER_CLIENT_SECRET=
IMMERSIVE_READER_SUBDOMAIN=

# Microsoft Entra ID sign-in (replaced by Auth.js in roadmap 4.3)
AZURE_AD_CLIENT_ID=
AZURE_AD_TENANT_ID=

# Dev mode: skips sign-in so the frontend's chat works locally (never in production)
DEV_MODE=false

# CORS: the Next.js frontend origin
FRONTEND_URL=http://localhost:3000
