# The only required setting is an LLM. Everything else is optional.

# LLM: groq (free tier, default) | openai (or any OpenAI-compatible API via LLM_BASE_URL)
#      | azure (uses AZURE_OPENAI_* below) | fake (offline, scripted)
LLM_PROVIDER=groq
# The provider's API key. For Groq, a free key from https://console.groq.com/keys
LLM_API_KEY=
# Optional: the API's base URL, for OpenAI-compatible providers other than OpenAI
LLM_BASE_URL=
# Optional: defaults to openai/gpt-oss-120b on Groq, gpt-4o on OpenAI
LLM_MODEL=
# Optional: low | medium | high for reasoning models (Groq defaults to low)
LLM_REASONING_EFFORT=
LLM_TIMEOUT_SECONDS=30

# Postgres: `docker compose up -d db` from the repo root, then `uv run alembic upgrade head`.
# Leave empty to run without saving anything (the task endpoints answer 503).
DATABASE_URL=postgresql+asyncpg://pebble:pebble@localhost:5432/pebble

# Azure OpenAI (only with LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Azure AI Content Safety (optional; without it content checks are off, PII redaction still runs)
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=

# Azure Immersive Reader (optional; the frontend falls back to its built-in reader)
IMMERSIVE_READER_TENANT_ID=
IMMERSIVE_READER_CLIENT_ID=
IMMERSIVE_READER_CLIENT_SECRET=
IMMERSIVE_READER_SUBDOMAIN=

# Sign-in: the same value as AUTH_TOKEN_SECRET in frontend/.env.local. The Next.js server signs a
# short-lived token with it for every API call. Generate one: openssl rand -base64 32
AUTH_TOKEN_SECRET=

# Agent calls per user (sliding windows), so one account can't use up the LLM's shared free tier. 0 turns one off.
AGENT_CALLS_PER_MINUTE=10
AGENT_CALLS_PER_DAY=100

# CORS: the Next.js frontend origin
FRONTEND_URL=http://localhost:3000
