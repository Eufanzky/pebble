        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get an Immersive Reader token",
        "tags": [
          "Documents"
        ]
      }
    },
    "/api/documents/parse": {
      "post": {
        "description": "Read the text of an uploaded document with a local parser (pypdf, python-docx).\n\nThe file is parsed in memory and **never stored**: nothing is written to disk or sent to\nanother service. Pass the returned `text` to `POST /api/agents/simplify` to simplify it.",
        "operationId": "parse_api_documents_parse_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_parse_api_documents_parse_post"
