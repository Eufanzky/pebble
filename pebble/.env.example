# Copy to .env.local. Sign-in (roadmap 4.3): Auth.js runs in Next.js and signs a
# short-lived token for every /api call, which the backend checks.

# Auth.js session secret. Generate one: npx auth secret (or openssl rand -base64 32)
AUTH_SECRET=
# Shared with the backend (backend/.env AUTH_TOKEN_SECRET, the same value)
AUTH_TOKEN_SECRET=
# Where the FastAPI backend runs
BACKEND_URL=http://localhost:8000

# GitHub sign-in: an OAuth app with callback http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google sign-in: an OAuth client with redirect URI http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Dev login: sign in under any name, no account needed. Local use and E2E only; never in production.
AUTH_DEV_LOGIN=true
